<div class="local-teacher-profile">
    <nav class="local-teacher-profile-breadcrumb" aria-label="{{backlabel}}">
        <a href="{{backurl}}"><span aria-hidden="true">&#8592;</span> {{backlabel}}</a>
        <span class="local-teacher-breadcrumb-divider" aria-hidden="true">/</span>
        <span aria-current="page">{{fullname}}</span>
    </nav>

    <header class="local-teacher-cv">
        <div class="local-teacher-cv-photo">
            <img src="{{pictureurl}}" alt="{{fullname}}" width="350" height="380">
        </div>
        <div class="local-teacher-cv-content">
            <div class="local-teacher-cv-heading-row">
                <div class="local-teacher-cv-name">
                    <p class="local-teacher-cv-eyebrow">{{cvtitle}}</p>
                    <h2>{{fullname}}</h2>
                </div>
                <div class="local-teacher-cv-actions">
                    {{#cancontact}}<a class="btn btn-primary local-teacher-cv-action-primary" href="#local-teacher-contact">{{contacttitle}}</a>{{/cancontact}}
                    {{#haslinkedin}}<a class="btn btn-outline-primary local-teacher-cv-action-outline" href="{{linkedinurl}}" target="_blank" rel="noopener noreferrer"><span class="local-teacher-linkedin-icon" aria-hidden="true">in</span> {{linkedinlabel}}</a>{{/haslinkedin}}
                </div>
            </div>
            <div class="local-teacher-cv-stats">
                {{#hasexperience}}
                <div class="local-teacher-cv-stat">
                    <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4m8-4v4M3 10h18"/></svg>
                    <span>{{experience}}</span>
                </div>
                {{/hasexperience}}
                <div class="local-teacher-cv-stat">
                    <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 9 10-5 10 5-10 5L2 9Z"/><path d="M6 11v5c3.5 3 8.5 3 12 0v-5"/></svg>
                    <span>{{coursecount}}</span>
                </div>
            </div>
            <section class="local-teacher-cv-biography" aria-label="{{biotitle}}">
                <h3>{{biotitle}}</h3>
                {{#hasbio}}<div class="local-teacher-bio-content">{{{biohtml}}}</div>{{/hasbio}}
                {{^hasbio}}<p class="local-teacher-cv-no-bio">{{nobiolabel}}</p>{{/hasbio}}
            </section>
        </div>
    </header>

    <section class="local-teacher-courses-section" aria-labelledby="local-teacher-courses-heading">
        <div class="local-teacher-courses-heading">
            <h2 id="local-teacher-courses-heading">{{profilecoursestitle}}</h2>
            <p>{{coursesintro}}</p>
        </div>
        {{#hascourses}}
        <div class="local-teacher-courses-grid">
            {{#coursescards}}
            <article class="local-teacher-course-card">
                <div class="local-teacher-course-cover"><img src="{{imageurl}}" alt="" loading="lazy" width="380" height="176"></div>
                <div class="local-teacher-course-card-body">
                    <h3><a href="{{url}}" title="{{name}}">{{name}}</a></h3>
                    <p>{{summary}}</p>
                    <a class="local-teacher-course-cta" href="{{url}}">{{buttonlabel}} <span aria-hidden="true">&#8594;</span></a>
                </div>
            </article>
            {{/coursescards}}
        </div>
        {{/hascourses}}
        {{^hascourses}}<div class="local-teacher-empty">{{nocourses}}</div>{{/hascourses}}
    </section>

    {{#cancontact}}
    <section class="local-teacher-section local-teacher-contact local-teacher-cv-contact" id="local-teacher-contact">
        <h2>{{contacttitle}}</h2>
        <form method="post" action="{{contactaction}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="send">
            <label for="local-teacher-message">{{contactlabel}}</label>
            <textarea class="form-control" id="local-teacher-message" name="message" rows="4" minlength="1" maxlength="2000" required></textarea>
            <button class="btn btn-primary" type="submit">{{contactbutton}}</button>
        </form>
    </section>
    {{/cancontact}}
</div>
