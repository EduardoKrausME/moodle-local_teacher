<div class="local-teacher-profile">
    <header class="local-teacher-lead">
        <div class="local-teacher-lead-content">
            <h2>{{fullname}}</h2>
            <nav class="local-teacher-profile-breadcrumb" aria-label="{{backtodirectory}}">
                <a href="{{backurl}}">
                    <span aria-hidden="true">&#8592;</span>
                    {{backtodirectory}}</a>
                <span class="local-teacher-breadcrumb-divider" aria-hidden="true">/</span>
                <span aria-current="page">{{fullname}}</span>
            </nav>
        </div>
        <div class="local-teacher-cv-stats">
            <div>
                {{#hasexperience}}
                    <div class="local-teacher-cv-stat">
                        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="16" rx="2"/>
                            <path d="M8 3v4m8-4v4M3 10h18"/>
                        </svg>
                        <span>{{graduationlabel}}</span>
                    </div>
                {{/hasexperience}}
                <div class="local-teacher-cv-stat">
                    <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m2 9 10-5 10 5-10 5L2 9Z"/>
                        <path d="M6 11v5c3.5 3 8.5 3 12 0v-5"/>
                    </svg>
                    <span>{{coursecountlabel}}</span>
                </div>
            </div>

            <div class="local-teacher-cv-heading-row">
                <div class="local-teacher-cv-actions">
                    {{#canedit}}
                        <a class="btn btn-outline-primary local-teacher-cv-action-outline" href="{{editurl}}">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 20h9"/>
                                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L9 17l-4 1 1-4Z"/>
                            </svg>
                            {{editlabel}}
                        </a>
                    {{/canedit}}
                    {{#cancontact}}
                        <button class="btn btn-primary local-teacher-cv-action-primary" type="button"
                                data-action="local-teacher-contact-open"
                                aria-haspopup="dialog">{{contactteacher}}
                        </button>
                    {{/cancontact}}
                    {{#haslinkedin}}
                        <a class="btn btn-outline-primary local-teacher-cv-action-outline" href="{{linkedinurl}}"
                           target="_blank" rel="noopener noreferrer">
                            <span class="local-teacher-linkedin-icon" aria-hidden="true">in</span>
                            {{viewlinkedin}}</a>
                    {{/haslinkedin}}
                </div>
            </div>
        </div>
        <div class="local-teacher-lead-decoration" aria-hidden="true"></div>
    </header>

    <header class="local-teacher-cv">
        <div class="local-teacher-cv-photo">
            <img src="{{pictureurl}}" alt="{{fullname}}" width="350" height="380">
        </div>
        <div class="local-teacher-cv-content">
            <section class="local-teacher-cv-biography">
                <h3>{{fullname}}</h3>
                {{#hasbio}}
                    <div class="local-teacher-bio-content">{{{biohtml}}}</div>
                {{/hasbio}}
                {{^hasbio}}
                    <p class="local-teacher-cv-no-bio">{{nobiography}}</p>
                {{/hasbio}}
            </section>
        </div>
    </header>

    <section class="local-teacher-courses-section" aria-labelledby="local-teacher-courses-heading">
        <div class="local-teacher-courses-heading">
            <h2 id="local-teacher-courses-heading">{{profilecoursestitle}}</h2>
            <p>{{profilecoursesintro}}</p>
        </div>
        {{#hascourses}}
            <div class="local-teacher-courses-grid{{#hasfivecourses}} local-teacher-courses-grid--five{{/hasfivecourses}}">
                {{#coursescards}}
                    <article class="local-teacher-course-card">
                        <div class="local-teacher-course-cover">
                            <img src="{{imageurl}}" alt="" loading="lazy" width="380" height="176">
                        </div>
                        <div class="local-teacher-course-card-body">
                            <h3><a href="{{url}}" title="{{name}}">{{name}}</a></h3>
                            <p>
                                {{#hassummary}}
                                    {{summary}}
                                {{/hassummary}}
                                {{^hassummary}}
                                    {{coursedescriptionfallback}}
                                {{/hassummary}}
                            </p>
                        </div>
                    </article>
                {{/coursescards}}
            </div>
        {{/hascourses}}
        {{^hascourses}}
            <div class="local-teacher-empty">{{nocourses}}</div>
        {{/hascourses}}
    </section>

    {{#cancontact}}
        <template id="local-teacher-contact-template">
            <form class="local-teacher-contact-form" method="post" action="{{contactaction}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="send">
                <label for="local-teacher-message">{{yourmessage}}</label>
                <textarea class="form-control" id="local-teacher-message" name="message" rows="5" minlength="1"
                          maxlength="2000" required></textarea>
                <div class="local-teacher-contact-buttons">
                    <button class="btn btn-secondary" type="button" data-action="local-teacher-contact-cancel">{{cancel}}</button>
                    <button class="btn btn-primary" type="submit">{{sendmessage}}</button>
                </div>
            </form>
        </template>
    {{/cancontact}}
</div>
